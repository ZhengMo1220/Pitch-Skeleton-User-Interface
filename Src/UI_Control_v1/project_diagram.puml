@startuml Pitch-Skeleton-User-Interface

skinparam class {
    BackgroundColor White
    ArrowColor Black
    BorderColor Black
}

package "UI_Control" {
    class Main {
        - model: Model
        + init_tabs()
    }

    class PoseVideoTabControl {
        - ui: Ui_video_widget
        - model: Model
        - viewer3d: Triangulate3DViewer
        + initVar()
        + loadVideo()
        + analyzeFrame()
    }

    class Triangulate3DViewer {
        - K_L, K_R: np.ndarray
        - F: np.ndarray
        - all_3d_frames: list
        + add_2d_keypoints()
        + get_skeleton_lines()
        + compute_joint_velocity()
    }
}

package "utils" {
    class Model {
        + setImageSize()
        + setDetectParser()
    }

    class ImageDrawer {
        + drawInfo()
        + setShowSkeleton()
    }

    class GraphPlotter {
        + updateGraph()
        + setPlotVisibility()
    }
}

package "cv_utils" {
    class VideoLoader {
        - video_name: str
        - is_loading: bool
        + loadVideo()
        + getVideoImage()
    }

    class JsonLoader {
        + load()
    }
}

package "skeleton" {
    class PoseEstimater {
        + detectKpt()
        + setProcessedData()
    }

    class DetectSkeleton {
        + detect()
    }
}

' 主要關係
Main *-- PoseVideoTabControl
PoseVideoTabControl *-- Triangulate3DViewer
PoseVideoTabControl *-- ImageDrawer
PoseVideoTabControl *-- GraphPlotter
PoseVideoTabControl *-- VideoLoader
PoseVideoTabControl *-- PoseEstimater
PoseVideoTabControl o-- Model

' 相依關係
VideoLoader ..> JsonLoader
PoseEstimater ..> DetectSkeleton

' 註解
note right of Main
  主程式入口，
  負責初始化UI和模型
end note

note right of PoseVideoTabControl
  主要的UI控制類別，
  處理影片和3D重建
end note

note right of Model
  模型管理類別，
  控制檢測和姿態估計
end note

package "External Dependencies" {
    class MMPose << (E,#FF7700) >>
    class MMYOLO << (E,#FF7700) >>
    class PyQt5 << (E,#FF7700) >>
    class Vispy << (E,#FF7700) >>
}

' 外部依賴關係
PoseEstimater ..> MMPose
Model ..> MMYOLO
PoseVideoTabControl ..> PyQt5
Triangulate3DViewer ..> Vispy

@enduml