@startuml

skinparam class {
    BackgroundColor White
    ArrowColor Black
    BorderColor Black
}

class PoseVideoTabControl {
    -- Attributes --
    - ui: Ui_video_widget
    - model: Model
    - is_play: bool
    - is_video: bool
    - view_scene: QGraphicsScene
    - curve_scene: QGraphicsScene
    - correct_kpt_idx: int
    - is_processed: bool
    - table: QTableWidget
    - json_path: str
    - viewer3d: Triangulate3DViewer
    - speed_angle_names: list
    - title_names: list
    - K_F: np.ndarray
    - K_S: np.ndarray
    - F: np.ndarray
    
    -- Methods --
    + __init__(model: Model, parent=None)
    + initVar()
    + setupComponents()
    + bindUI()
    + resizeEvent(event)
    + initFrameSlider()
    + initGraph()
    + playBtnClicked()
    + mousePressEvent(event)
    + keyPressEvent(event)
    + loadVideo(is_processed: bool)
    + loadProcessedData()
    + checkVideoLoad()
    + updateVideoInfo()
    + showImage(image: np.ndarray, scene: QGraphicsScene, GraphicsView: QGraphicsView)
    + showGraph(container_widget: QWidget)
    + playFrame(start_num: int)
    + phaseDetection(frame_num: int)
    + analyzeFrame()
    + updateFrame(frame_num: int)
    + toggleDetect()
    + toggleSelect(state: int)
    + toggleKptSelect(state: int)
    + toggleShowSkeleton(state: int)
    + toggleShowBbox(state: int)
    + toggleShowAngleInfo(state: int)
    + toggleShowGraph(name: str, state: int)
}

class SliderColorOverlay {
    -- Attributes --
    - slider: QSlider
    - segments: list
    
    -- Methods --
    + __init__(slider: QSlider, segments: list)
    + updateSegments(segments)
    + paintEvent(event)
}

class PersonSelector {
    -- Methods --
    + select(search_person_df)
    + reset()
}

class KptSelector {
    -- Methods --
    + reset()
}

class PoseEstimater {
    -- Methods --
    + detectKpt(frame, frame_num, is_video, is_processed)
    + setPersonId(id)
    + setKptId(id)
    + setDetect(enabled)
    + getPersonDf(frame_num)
    + reset()
}

class GraphPlotter {
    -- Methods --
    + _init_graph(total_frames)
    + updateGraph(frame_num)
    + setPlotVisibility(name, enabled)
    + reset()
}

class ImageDrawer {
    -- Methods --
    + drawInfo(image, frame_num, kpt_buffer)
    + setShowTraj(enabled)
    + setShowSkeleton(enabled)
    + setShowBbox(enabled)
    + setShowAngleInfo(enabled)
    + reset()
}

class VideoLoader {
    -- Attributes --
    - video_name: str
    - folder_path: str
    - is_loading: bool
    - total_frames: int
    
    -- Methods --
    + loadVideo()
    + getVideoImage(frame_num)
    + saveVideo(folder_path)
}

class Triangulate3DViewer {
    -- Attributes --
    - K_L: np.ndarray
    - K_R: np.ndarray
    - F: np.ndarray
    - all_3d_frames: list
    - frame_idx: int
    - canvas: SceneCanvas
    - view: ViewBox
    
    -- Methods --
    + add_2d_keypoints(frame_L, frame_R)
    + get_skeleton_lines(points_3d)
    + draw_plane_normal(frame_idx)
    + update(event)
    + set_frame(frame_idx)
    + get_distance_between(idx1, idx2, frame_idx)
    + compute_joint_velocity(joint_idx, delta_t)
    + arm_cocking_angle(frame_idx)
    + calculate_angle_between_shoulder_hip_lines(frame_idx)
    + reset()
}

' Relationships
PoseVideoTabControl *-- SliderColorOverlay
PoseVideoTabControl *-- PersonSelector
PoseVideoTabControl *-- KptSelector
PoseVideoTabControl *-- PoseEstimater
PoseVideoTabControl *-- GraphPlotter
PoseVideoTabControl *-- ImageDrawer
PoseVideoTabControl *-- VideoLoader
PoseVideoTabControl *-- Triangulate3DViewer

PoseVideoTabControl o-- "ui" Ui_video_widget
PoseEstimater o-- "model" Model

note right of PoseVideoTabControl
  主要的視窗控制類別，
  整合所有元件和功能
end note

note right of Triangulate3DViewer
  處理3D重建和視覺化，
  包含骨架分析功能
end note

@enduml